{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "Panneau « Que fait mon agent ? » et fils privés : statut, journal, pause, reprise, réveil, arrêt d'urgence messages avec l'agent et réponses par les CLI. Aucun accès fichier, shell, réseau ou notification depuis le webview.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-document-browse",
    "allow-series-assembly",
    "allow-conversation-image",
    "allow-conversation-image-import",
    "allow-authorizations-read",
    "allow-authorizations-save",
    "allow-app-update",
    "allow-app-version",
    "allow-app-restart",
    "allow-wake-restart",
    "allow-app-fullscreen",
    "allow-wake-status",
    "allow-onboarding-status",
    "allow-onboarding-start",
    "allow-workspace-sync-status",
    "allow-workspace-sync-configure",
    "allow-workspace-sync-now",
    "allow-elevenlabs",
    "allow-wake-journal",
    "allow-wake-pause",
    "allow-wake-resume",
    "allow-wake-stop",
    "allow-wake-now",
    "allow-wake-on",
    "allow-wake-always-on",
    "allow-wake-messages",
    "allow-wake-history",
    "allow-wake-order",
    "allow-second-thread",
    "allow-wake-coach",
    "allow-wake-forks",
    "allow-wake-open-location",
    "allow-open-external-url",
    "allow-wake-reply",
    "allow-voice-input",
    "allow-helpers-answers",
    "allow-owner-threads",
    "allow-owner-thread",
    "allow-owner-reply",
    "allow-broadcast-status",
    "allow-broadcast-send",
    "allow-recipient-status",
    "allow-recipient-send",
    "allow-recipient-poll"
  ]
}
