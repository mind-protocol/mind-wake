{
  "extends": "common.json",
  "on": {
    "turn/start": {
      "result": {
        "turn": {
          "id": "turn_1",
          "status": "inProgress",
          "items": [],
          "error": null
        }
      },
      "then": [
        {
          "notify": "turn/started",
          "params": {
            "threadId": "thr_1",
            "turn": {
              "id": "turn_1",
              "status": "inProgress",
              "items": []
            }
          }
        },
        {
          "notify": "error",
          "params": {
            "threadId": "thr_1",
            "turnId": "turn_1",
            "willRetry": true,
            "error": {
              "message": "stream error, retrying",
              "codexErrorInfo": {
                "responseStreamConnectionFailed": {
                  "httpStatusCode": null
                }
              }
            }
          }
        },
        {
          "notify": "turn/completed",
          "params": {
            "threadId": "thr_1",
            "turn": {
              "id": "turn_1",
              "status": "failed",
              "items": [],
              "error": {
                "message": "401 Unauthorized",
                "codexErrorInfo": {
                  "responseStreamConnectionFailed": {
                    "httpStatusCode": 401
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
