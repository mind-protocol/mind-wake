{
  "extends": "common.json",
  "on": {
    "turn/start": {
      "result": { "turn": { "id": "turn_1", "status": "inProgress", "items": [], "error": null } }
    },
    "turn/interrupt": {
      "result": {},
      "then": [
        {
          "notify": "turn/completed",
          "params": {
            "threadId": "thr_1",
            "turn": { "id": "turn_1", "status": "interrupted", "error": null }
          }
        }
      ]
    }
  }
}
