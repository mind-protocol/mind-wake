{
  "name": "mind-wake",
  "version": "0.0.0",
  "private": true,
  "description": "MIND Wake — local daemon and CLI giving an AI agent bounded spare compute (v0.1, in development).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mind-wake": "dist/cli/main.js"
  },
  "engines": {
    "node": "^24.17.0 || ^26.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo:advice": "node --disable-warning=ExperimentalWarning --import ./test/fixtures/store-ledger/ts-hooks.ts services/advice/demo/main.ts",
    "demo:wake": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./test/fixtures/store-ledger/ts-hooks.ts test/demo/demo-simulee.ts",
    "desktop:ui": "tsc -p desktop/ui/tsconfig.json",
    "desktop": "npm run build && npm run desktop:ui && cargo run --manifest-path desktop/src-tauri/Cargo.toml",
    "devnet:kit": "node --disable-warning=ExperimentalWarning --import ./test/fixtures/store-ledger/ts-hooks.ts services/advice/rail-solana-devnet/kit-main.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@solana-program/memo": "0.15.0",
    "@solana-program/system": "0.15.0",
    "@solana-program/token-2022": "0.19.0",
    "@solana/kit": "8.4.0",
    "@solana/sysvars": "8.4.0",
    "@solana/zk-sdk": "0.5.3",
    "better-sqlite3": "13.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
