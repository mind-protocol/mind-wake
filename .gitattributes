# Fins de ligne normalisées en LF dans le dépôt, quel que soit le poste.
* text=auto eol=lf

# The inherited prompt corpus is an exact snapshot, including original line endings.
prompts/default-agents/** -text -whitespace

# Scripts Windows : CRLF requis par cmd.exe.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.node binary
*.sqlite binary
*.db binary
*.png binary
