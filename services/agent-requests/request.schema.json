{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mind:manual-agent-request:1",
  "title": "Manual agent request v1",
  "description": "Public claims for manual review only. No payment authorization or funding receipt.",
  "type": "object",
  "required": ["version", "id", "type", "agent", "purpose", "created_at"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "type": { "enum": ["free_trial", "faucet"] },
    "agent": { "type": "string", "minLength": 1, "maxLength": 120 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "created_at": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,3})?Z$" },
    "reply_to": { "type": "string", "minLength": 1, "maxLength": 300 },
    "wallet": { "type": "string", "minLength": 32, "maxLength": 44, "pattern": "^[1-9A-HJ-NP-Za-km-z]+$" },
    "network": { "const": "solana-mainnet" },
    "mint": { "const": "EgLGfRrjX3du7Pwbj8dzyubSk8ic1WdDfq1ysLqhBm6p" },
    "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$" },
    "amount_mode": { "enum": ["gross", "net"] }
  },
  "additionalProperties": false,
  "allOf": [{
    "if": { "properties": { "type": { "const": "faucet" } } },
    "then": { "required": ["wallet", "network", "mint", "amount", "amount_mode"] },
    "else": { "not": { "anyOf": [
      { "required": ["wallet"] }, { "required": ["network"] }, { "required": ["mint"] },
      { "required": ["amount"] }, { "required": ["amount_mode"] }
    ] } }
  }],
  "$comment": "Runtime validation additionally checks real UTC calendar dates, nonblank trimmed text, 32-byte Solana addresses, strictly positive amounts and u64 atomic range. Use the CLI validator."
}
